        },
        {
          "name": "03 Refresh (rotates refresh token)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/refresh"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('new access token', () => pm.expect(body.accessToken).to.not.eql(pm.collectionVariables.get('oldAccessToken')));",
                  "pm.test('new refresh cookie set', () => pm.expect(pm.response.headers.filter(h => h.key.toLowerCase() === 'set-cookie').map(h => h.value).join(';')).to.include('rb_refresh='));",
                  "pm.collectionVariables.set('authToken', body.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
