    {
      "name": "Auth (lab 2)",
      "item": [
        {
          "name": "01 Login member (access token + refresh cookie)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ieva@rentbase.lt\",\n  \"password\": \"Member123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('access token in body', () => pm.expect(body.accessToken).to.be.a('string'));",
                  "pm.test('refresh token is NOT in body', () => pm.expect(body).to.not.have.property('refreshToken'));",
                  "const setCookie = pm.response.headers.filter(h => h.key.toLowerCase() === 'set-cookie').map(h => h.value).join(';');",
                  "pm.test('refresh cookie is HttpOnly', () => { pm.expect(setCookie).to.include('rb_refresh='); pm.expect(setCookie.toLowerCase()).to.include('httponly'); });",
                  "const claims = JSON.parse(decodeURIComponent(escape(atob(body.accessToken.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')))));",
                  "console.log('access token claims', claims);",
                  "pm.test('token holds user id, role and session id', () => { pm.expect(claims.sub).to.eql(String(body.user.id)); pm.expect(claims.role || claims['http://schemas.microsoft.com/ws/2008/06/identity/claims/role']).to.eql('Member'); pm.expect(claims.sid).to.be.a('string'); });",
                  "pm.test('access token lives about 15 minutes', () => pm.expect(claims.exp - (claims.iat || claims.nbf)).to.be.at.most(15 * 60));",
                  "pm.collectionVariables.set('authToken', body.accessToken);",
                  "pm.collectionVariables.set('oldAccessToken', body.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "02 Profile with access token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
