{
  "info": {
    "name": "RentBase API",
    "description": "Lab 1 demo collection. Run the Lab demo folder with the Collection Runner (it captures tokens and ids). Edge cases folder now logs in first, so it can be run on its own.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "memberToken",
      "value": ""
    },
    {
      "key": "buildingId",
      "value": "1"
    },
    {
      "key": "apartmentId",
      "value": "1"
    },
    {
      "key": "reservationId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Lab demo",
      "item": [
        {
          "name": "01 Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@rentbase.lt\",\n  \"password\": \"Admin123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('adminToken', body.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Login member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ieva@rentbase.lt\",\n  \"password\": \"Member123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('memberToken', body.token);",
                  "pm.collectionVariables.set('userId', body.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "03 List buildings (paged + filter)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/buildings?city=Vilnius&page=1&pageSize=5"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('paged items', () => pm.expect(body.items).to.be.an('array'));",
                  "pm.test('has links', () => pm.expect(body.links).to.have.property('self'));",
                  "if (body.items.length > 0) pm.collectionVariables.set('buildingId', body.items[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Get single building",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/buildings/{{buildingId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('has self link', () => pm.expect(pm.response.json().links.self).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "05 List apartments for building (hierarchical)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/buildings/{{buildingId}}/apartments?page=1&pageSize=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('paged', () => pm.expect(body.items).to.be.an('array'));",
                  "if (body.items.length > 0) pm.collectionVariables.set('apartmentId', body.items[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Get single apartment",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/apartments/{{apartmentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('has reservations link', () => pm.expect(pm.response.json().links.reservations).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "07 Full hierarchy reservations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{memberToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/buildings/{{buildingId}}/apartments/{{apartmentId}}/reservations"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('paged response', () => pm.expect(pm.response.json().items).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "08 Member profile (multi-entity)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{memberToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/me/profile"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('has user', () => pm.expect(body.user).to.have.property('id'));",
                  "pm.test('has reservations', () => pm.expect(body.recentReservations).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "09 Create building (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/buildings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo namas\",\n  \"address\": \"Student\u0173 g. 50\",\n  \"city\": \"Kaunas\",\n  \"description\": \"Sukurta gynimo demonstracijai.\",\n  \"yearBuilt\": 2019\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('buildingId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "10 Update building",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/buildings/{{buildingId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo namas (atnaujintas)\",\n  \"address\": \"Student\u0173 g. 50\",\n  \"city\": \"Kaunas\",\n  \"description\": \"Atnaujintas apra\u0161ymas.\",\n  \"yearBuilt\": 2020\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "11 Create apartment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/apartments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"buildingId\": {{buildingId}},\n  \"number\": \"99\",\n  \"floor\": 2,\n  \"areaSqm\": 48.5,\n  \"rooms\": 2,\n  \"monthlyRent\": 550,\n  \"isAvailable\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('apartmentId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "12 List apartments filtered",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/apartments?buildingId={{buildingId}}&available=true&page=1&pageSize=5"
